# === DEMO-TRADE environment example ===
# Copy to .env for local dev. Never commit real secrets.

# --- App / mode ---
APP_ENV=development
DEMO_MODE=true            # true = deterministic mock providers, no external keys needed
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_SECRET_KEY=dev-only-change-me-32chars-min-xxxxxxxxxx
API_DEMO_USER_EMAIL=demo@demo-trade.local

# --- Session auth (shared between web app + API) ---
# HS256-signed JWT session cookies. AUTH_SECRET must be 32+ random bytes
# in production and MUST be identical in the web + api containers.
AUTH_SECRET=
AUTH_COOKIE_NAME=demo-trade.session
AUTH_SESSION_MAX_AGE_S=604800

# GitHub OAuth (production). Register a GitHub OAuth App and paste here.
# Callback URL: {your host}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Required by Auth.js when hostname differs from localhost
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Database ---
POSTGRES_USER=demotrade
POSTGRES_PASSWORD=demotrade
POSTGRES_DB=demotrade
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://demotrade:demotrade@postgres:5432/demotrade
ALEMBIC_DATABASE_URL=postgresql://demotrade:demotrade@postgres:5432/demotrade

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_APP_NAME=DEMO-TRADE

# --- Agent LLM (Phase 4; unused in Phase 1) ---
# Providers: mock (default), anthropic, openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Real data providers (Phase 2; leave blank in demo mode) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
SSI_FC_CONSUMER_ID=
SSI_FC_CONSUMER_SECRET=
COINBASE_API_URL=https://api.exchange.coinbase.com
